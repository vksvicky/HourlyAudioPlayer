# Copy to .env.signing and fill in (do not commit .env.signing).
# Then: export $(grep -v '^#' .env.signing | xargs) && NOTARIZE=1 ./build_release.sh 1.3.0

DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (XXXXXXXXXX)"
APPLE_TEAM_ID=XXXXXXXXXX

# Recommended: store notary credentials once:
# xcrun notarytool store-credentials "HourlyAudioPlayer-notary" \
#   --apple-id "you@example.com" --team-id "XXXXXXXXXX" --password "app-specific-password"
NOTARY_KEYCHAIN_PROFILE=HourlyAudioPlayer-notary

# Alternative to keychain profile:
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

NOTARIZE=1
